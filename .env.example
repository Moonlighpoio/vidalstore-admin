PORT=3020
NODE_ENV=development

# RabbitMQ: escrituras por AMQP y listados por la API HTTP de administración.
RABBITMQ_URL=amqp://vidalstore:cambia_esta_password@localhost:5672
RABBITMQ_MANAGEMENT_URL=http://localhost:15672
RABBITMQ_MANAGEMENT_USER=vidalstore
RABBITMQ_MANAGEMENT_PASSWORD=cambia_esta_password
RABBITMQ_VHOST=/

# Cognito (vidalstore-admin valida el token él mismo, no va detrás del gateway)
COGNITO_REGION=us-east-1
COGNITO_USER_POOL_ID=us-east-1_example
COGNITO_APP_CLIENT_ID=example-client-id
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_example
COGNITO_JWKS_URI=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_example/.well-known/jwks.json
